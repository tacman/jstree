{
  "name": "@tacman1123/jstree-esm",
  "title": "jsTree",
  "description": "jsTree v4 fork with Stimulus-first API and native DOM events",
  "version": "4.1.0",
  "homepage": "https://github.com/tacman/jstree",
  "main": "./src/jstree.js",
  "module": "./jstree.esm.mjs",
  "buildName": "jstree",
  "files": [
    "LICENSE-MIT",
    "README.md",
    "dist/themes/**/*",
    "src/**/*",
    "jstree.browser-module.js",
    "jstree.browser-module.mjs",
    "jstree.esm.browser.js",
    "jstree.esm.browser.mjs",
    "jstree.esm.mjs",
    "jstree.module.mjs",
    "jstree.stimulus.mjs"
  ],
  "exports": {
    ".": {
      "import": "./jstree.esm.mjs",
      "require": "./src/jstree.js",
      "default": "./src/jstree.js"
    },
    "./module": "./jstree.module.mjs",
    "./esm": "./jstree.esm.mjs",
    "./browser-module": {
      "import": "./jstree.browser-module.mjs",
      "default": "./jstree.browser-module.js"
    },
    "./esm-browser": {
      "import": "./jstree.esm.browser.mjs",
      "default": "./jstree.esm.browser.js"
    },
    "./stimulus": "./jstree.stimulus.mjs",
    "./jquery-plugin": "./src/jstree.js",
    "./src/*": "./src/*",
    "./dist/themes/*": "./dist/themes/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "author": {
    "name": "Ivan Bozhanov",
    "email": "jstree@jstree.com",
    "url": "http://vakata.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tacman/jstree.git"
  },
  "bugs": {
    "url": "https://github.com/tacman/jstree/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/vakata/jstree/blob/master/LICENSE-MIT"
    }
  ],
  "keywords": [],
  "devDependencies": {
    "dox": "^1.0.0",
    "grunt": "~1.6.1",
    "grunt-contrib-concat": "^2.1.0",
    "grunt-contrib-copy": "*",
    "grunt-contrib-imagemin": "^4.0.0",
    "grunt-contrib-jshint": "^3.2.0",
    "grunt-contrib-less": "^3.0.0",
    "grunt-contrib-uglify": "^5.2.2",
    "grunt-contrib-watch": "~1.1.0",
    "grunt-text-replace": "~0.4.0"
  },
  "dependencies": {
    "jquery": "^4.0.0"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.2.0"
  },
  "scripts": {
    "pack:check": "npm pack --dry-run",
    "release:check": "npm run pack:check"
  },
  "npmName": "jstree",
  "npmFileMap": [
    {
      "basePath": "/dist/",
      "files": [
        "themes/**/*.png",
        "themes/**/*.gif",
        "themes/**/*.min.css"
      ]
    }
  ]
}
